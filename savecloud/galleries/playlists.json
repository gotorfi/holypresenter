                            "tag": "Verse2",
                            "elements": [
                                {
                                    "type": "text",
                                    "text": "I'll never be the same\nI can face anything, so let it rain",
                                    "x": 151,
                                    "y": 254,
                                    "w": 1212,
                                    "h": 338
                                }
                            ]
                        },
