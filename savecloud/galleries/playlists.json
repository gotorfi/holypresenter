                            ]
                        },
                        {
                            "thumbnail": "asset/ui/transparent.png",
                            "tag": "Verse2",
                            "elements": [
                                {
                                    "type": "text",
                                    "text": "When I get tired of fightin'\nAll of the fears I've been hiding",
                                    "x": 151,
