      "number": 2,
      "elements": [
        {
          "id": 0,
          "type": "text",
          "rect": [
            610,
            251,
            775,
            284
          ],
          "content": "H\u00e4nen k\u00e4skyst\u00e4ns\u00e4\nLaulaa mykk\u00e4 suu",
          "font_size": 48,
          "color": [
            255,
            255,
            255
          ],
          "align": "center"
        }
      ]
    },
    {
      "name": "Slide 3",
      "tag": "Verse1",
      "number": 3,
      "elements": [
        {
          "id": 0,
          "type": "text",
          "rect": [
            610,
            251,
            775,
            284
          ],
          "content": "H\u00e4n saa laineetkin laantumaan\nMyrskytuulen voimallaan",
          "font_size": 48,
          "color": [
            255,
            255,
            255
          ],
          "align": "center"
        }
      ]
    },
    {
      "name": "Slide 4",
      "tag": "Verse1",
      "number": 4,
      "elements": [
        {
          "id": 0,
          "type": "text",
          "rect": [
            610,
            251,
            775,
            284
          ],
          "content": "H\u00e4nen eteens\u00e4 polvistuu\nT\u00e4hdet, aurinko ja kuu",
          "font_size": 48,
          "color": [
            255,
            255,
            255
          ],
          "align": "center"
        }
      ]
    },
    {
      "name": "Slide 5",
      "tag": "Chorus1",
      "number": 5,
      "elements": [
        {
          "id": 0,
          "type": "text",
          "rect": [
            610,
            251,
            775,
            284
          ],
          "content": "Maailman \u00e4\u00e4rist\u00e4 ei l\u00f6ydy toista\nNiin kuin on Herramme, niin suurenmoista",
          "font_size": 48,
          "color": [
            255,
            255,
            255
          ],
          "align": "center"
        }
      ]
    },
    {
      "name": "Slide 6",
      "tag": "Chorus1",
      "number": 6,
      "elements": [
        {
          "id": 0,
          "type": "text",
          "rect": [
            610,
            251,
            775,
            284
          ],
          "content": "Ei l\u00f6ydy mist\u00e4\u00e4n H\u00e4nen vertaistaan\nValta ja voima on Vapahtajalla",
          "font_size": 48,
          "color": [
            255,
            255,
            255
          ],
          "align": "center"
        }
      ]
    },
    {
      "name": "Slide 7",
      "tag": "Chorus1",
      "number": 7,
      "elements": [
        {
          "id": 0,
          "type": "text",
          "rect": [
            610,
            251,
            775,
            284
          ],
          "content": "Suurin ja mahtavin auringon alla\nTaivaskin t\u00e4ynn\u00e4 on H\u00e4nen kirkkauttaan",
          "font_size": 48,
          "color": [
            255,
            255,
            255
          ],
          "align": "center"
        }
      ]
    },
    {
      "name": "Slide 8",
      "tag": "Verse2",
      "number": 8,
      "elements": [
        {
          "id": 0,
          "type": "text",
          "rect": [
            610,
            251,
            775,
            284
          ],
          "content": "Veden viiniksi muuttaa H\u00e4n\nAntaa leip\u00e4\u00e4 el\u00e4m\u00e4n",
          "font_size": 48,
          "color": [
            255,
            255,
            255
          ],
          "align": "center"
        }
      ]
    },
    {
      "name": "Slide 9",
      "tag": "Verse2",
      "number": 9,
      "elements": [
        {
          "id": 0,
          "type": "text",
          "rect": [
            610,
            251,
            775,
            284
          ],
          "content": "Kansa n\u00e4lk\u00e4inen saa\nMannaa sy\u00f6d\u00e4kseen",
          "font_size": 48,
          "color": [
            255,
            255,
            255
          ],
          "align": "center"
        }
      ]
    },
    {
      "name": "Slide 10",
