      "number": 10,
      "elements": [
        {
          "id": 0,
          "type": "text",
          "rect": [
            610,
            251,
            775,
            284
          ],
          "content": "H\u00e4n saa syd\u00e4men syttym\u00e4\u00e4n\nH\u00e4n tuo toivon pime\u00e4\u00e4n",
          "font_size": 48,
          "color": [
            255,
            255,
            255
          ],
          "align": "center"
        }
      ]
    },
    {
      "name": "Slide 11",
      "tag": "Verse2",
      "number": 11,
      "elements": [
        {
          "id": 0,
          "type": "text",
          "rect": [
            610,
            251,
            775,
            284
          ],
          "content": "Kaikki katsovat Kristukseen\nKiitos kaikuu korkeuteen",
          "font_size": 48,
          "color": [
            255,
            255,
            255
          ],
          "align": "center"
        }
      ]
    },
    {
      "name": "Slide 12",
      "tag": "Bridge",
      "number": 12,
      "elements": [
        {
          "id": 0,
          "type": "text",
          "rect": [
            610,
            251,
            775,
            284
          ],
          "content": "Ei l\u00f6ydy, ei l\u00f6ydy\nEi l\u00f6ydy ket\u00e4\u00e4n toista",
          "font_size": 48,
          "color": [
            255,
