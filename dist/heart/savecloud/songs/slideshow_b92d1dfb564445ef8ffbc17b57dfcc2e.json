          "type": "text",
          "rect": [
            610,
            251,
            775,
            284
          ],
          "content": "H\u00e4n saa kuuronkin kuulemaan\nRampa nousee vuoteeltaan",
          "font_size": 48,
          "color": [
            255,
            255,
            255
          ],
          "align": "center"
        }
      ]
    },
    {
      "name": "Slide 2",
