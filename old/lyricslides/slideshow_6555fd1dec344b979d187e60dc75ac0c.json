      "elements": [
        {
          "id": 0,
          "type": "text",
          "rect": [
            610,
            251,
            775,
            284
          ],
          "content": "en ehk\u00e4 koskaan saavukaan\nen ihmemaahan, onnelaan",
          "font_size": 48,
          "color": [
            255,
            255,
            255
          ],
          "align": "center"
        }
