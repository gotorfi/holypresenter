          "id": 0,
          "type": "text",
          "rect": [
            610,
            251,
            775,
            284
          ],
          "content": "syv\u00e4lt\u00e4 silm\u00e4t verest\u00e4\u00e4\nhetken lapsi niiss\u00e4 v\u00e4l\u00e4ht\u00e4\u00e4\njos voisin lent\u00e4\u00e4 pois",
          "font_size": 48,
          "color": [
