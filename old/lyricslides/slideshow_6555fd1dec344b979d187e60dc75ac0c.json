        {
          "id": 0,
          "type": "text",
          "rect": [
            610,
            251,
            775,
            284
          ],
          "content": "kahvip\u00f6yd\u00e4ll\u00e4 tupakantumppeja\novella polveen asti laskuja\njos voisin lent\u00e4\u00e4 pois",
          "font_size": 48,
          "color": [
            255,
