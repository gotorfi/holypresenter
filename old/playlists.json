      {
        "id": "6555fd1dec344b979d187e60dc75ac0c",
        "name": "Onnela",
        "slides": [
          {
            "name": "Slide 1",
            "tag": "Verse1",
            "number": 1,
            "elements": [
              {
                "id": 0,
                "type": "text",
                "rect": [
                  610,
                  251,
                  775,
                  284
                ],
                "content": "kasvoilla piirteet joita en tunnista\nvanhentuneet huomaamatta\njos voisin lent\u00e4\u00e4 pois",
                "font_size": 48,
                "color": [
                  255,
                  255,
                  255
                ],
                "align": "center"
              }
            ]
          },
          {
            "name": "Slide 2",
            "tag": "Verse1",
            "number": 2,
            "elements": [
              {
                "id": 0,
                "type": "text",
                "rect": [
                  610,
                  251,
                  775,
                  284
                ],
                "content": "syv\u00e4lt\u00e4 silm\u00e4t verest\u00e4\u00e4\nhetken lapsi niiss\u00e4 v\u00e4l\u00e4ht\u00e4\u00e4\njos voisin lent\u00e4\u00e4 pois",
                "font_size": 48,
                "color": [
                  255,
                  255,
                  255
                ],
                "align": "center"
              }
            ]
          },
          {
            "name": "Slide 3",
            "tag": "PreChorus1",
            "number": 3,
            "elements": [
              {
                "id": 0,
                "type": "text",
                "rect": [
                  610,
                  251,
                  775,
                  284
                ],
                "content": "miten vilauksessa vuodet kiit\u00e4\u00e4 voi\nvuodet kiit\u00e4\u00e4, p\u00e4iv\u00e4t matelee\nja varjot tummenee",
                "font_size": 48,
                "color": [
                  255,
                  255,
                  255
                ],
                "align": "center"
              }
            ]
          },
          {
            "name": "Slide 4",
            "tag": "Chorus1",
            "number": 4,
            "elements": [
              {
                "id": 0,
                "type": "text",
                "rect": [
                  610,
                  251,
                  775,
                  284
                ],
                "content": "en ehk\u00e4 koskaan kiinni saa\nen yht\u00e4\u00e4n suurta unelmaa",
                "font_size": 48,
                "color": [
                  255,
                  255,
                  255
                ],
                "align": "center"
              }
            ]
          },
          {
            "name": "Slide 5",
            "tag": "Chorus1",
            "number": 5,
            "elements": [
              {
                "id": 0,
                "type": "text",
                "rect": [
                  610,
                  251,
                  775,
                  284
                ],
                "content": "en ehk\u00e4 koskaan saavukaan\nen ihmemaahan, onnelaan",
                "font_size": 48,
                "color": [
                  255,
                  255,
                  255
                ],
                "align": "center"
              }
            ]
          },
          {
            "name": "Slide 6",
            "tag": "Verse2",
            "number": 6,
            "elements": [
              {
                "id": 0,
                "type": "text",
                "rect": [
                  610,
                  251,
                  775,
                  284
                ],
                "content": "kahvip\u00f6yd\u00e4ll\u00e4 tupakantumppeja\novella polveen asti laskuja\njos voisin lent\u00e4\u00e4 pois",
                "font_size": 48,
                "color": [
                  255,
                  255,
                  255
                ],
                "align": "center"
              }
            ]
          },
          {
            "name": "Slide 7",
            "tag": "Verse2",
            "number": 7,
            "elements": [
              {
                "id": 0,
                "type": "text",
                "rect": [
                  610,
                  251,
                  775,
                  284
                ],
                "content": "keitti\u00f6ss\u00e4 istuu kuolema\nistuu ja h\u00f6rppii kahvia\njos voisin lent\u00e4\u00e4 pois",
                "font_size": 48,
                "color": [
                  255,
                  255,
                  255
                ],
                "align": "center"
              }
            ]
          },
          {
            "name": "Slide 8",
            "tag": "Bridge",
            "number": 8,
            "elements": [
              {
                "id": 0,
                "type": "text",
                "rect": [
                  610,
                  251,
                  775,
                  284
                ],
                "content": "on niin helppoo luovuttaa\njos vain eteen tuijottaa\nkohti tiet\u00e4 vastaan nousevaa",
                "font_size": 48,
                "color": [
                  255,
                  255,
                  255
                ],
                "align": "center"
              }
            ]
          },
          {
            "name": "Slide 9",
            "tag": "Bridge",
            "number": 9,
            "elements": [
              {
                "id": 0,
                "type": "text",
                "rect": [
                  610,
                  251,
                  775,
                  284
                ],
                "content": "eik\u00e4 tajua ollenkaan vilkaista olkansa taa\nkuinka kauas jo on tullutkaan",
                "font_size": 48,
                "color": [
                  255,
                  255,
                  255
                ],
                "align": "center"
              }
            ]
          },
          {
            "name": "Slide 10",
            "tag": "Chorus2",
            "number": 10,
            "elements": [
              {
                "id": 0,
                "type": "text",
                "rect": [
                  610,
                  251,
                  775,
                  284
                ],
                "content": "mut en voi luovuttaa",
                "font_size": 48,
                "color": [
                  255,
                  255,
                  255
                ],
                "align": "center"
              }
            ]
          }
        ],
        "type": "lyrics"
      }
    ]
