  {
    "name": "playlist0",
    "id": "playlist0",
    "slideshows": [
      {
        "id": "3bce8afb64bd4849840e6044e1187a4e",
        "name": "Alusta asti",
        "slides": [
          {
            "name": "Slide 9",
            "tag": "Verse1",
            "number": 1,
            "elements": [
              {
                "id": 0,
                "type": "text",
                "rect": [
                  610,
                  251,
                  775,
                  284
                ],
                "content": "Niin kuin alusta asti ollut on,\nyh\u00e4 voimasi on niin suunnaton.",
                "font_size": 48,
                "color": [
                  255,
                  255,
                  255
                ],
                "align": "center"
              }
            ]
          },
          {
            "name": "Slide 2",
            "tag": "Verse1",
            "number": 2,
            "elements": [
              {
                "id": 0,
                "type": "text",
                "rect": [
                  610,
                  251,
                  775,
                  284
                ],
                "content": "Yksi sana vain riitti luomiseen,\nSinun k\u00e4tesi kantaa huomiseen.",
                "font_size": 48,
                "color": [
                  255,
                  255,
                  255
                ],
                "align": "center"
              }
            ]
          },
          {
            "name": "Slide 11",
            "tag": "Verse2",
            "number": 3,
            "elements": [
              {
                "id": 0,
                "type": "text",
                "rect": [
                  610,
                  251,
                  775,
                  284
                ],
                "content": "Niin kuin alusta asti ollut on, \nyh\u00e4 risti on p\u00e4\u00e4ll\u00e4 kallion.",
                "font_size": 48,
                "color": [
                  255,
                  255,
                  255
                ],
                "align": "center"
              }
            ]
          },
          {
            "name": "Slide 9",
            "tag": "Verse2",
            "number": 4,
            "elements": [
              {
                "id": 0,
                "type": "text",
                "rect": [
                  610,
                  251,
                  775,
                  284
                ],
                "content": "Silt\u00e4 ristilt\u00e4 kerran heitettiin meid\u00e4n\nsyntimme merten syvyyksiin.",
                "font_size": 48,
                "color": [
                  255,
                  255,
                  255
                ],
                "align": "center"
              }
            ]
          },
          {
            "name": "Slide 10",
            "tag": "Chorus1",
            "number": 5,
            "elements": [
              {
                "id": 0,
                "type": "text",
                "rect": [
                  610,
                  251,
                  775,
                  284
                ],
                "content": "Niin kuin alusta asti ollut on, \nloistaa kasvosi lailla auringon",
                "font_size": 48,
                "color": [
                  255,
                  255,
                  255
                ],
                "align": "center"
              }
            ]
          },
          {
            "name": "Slide 6",
            "tag": "Chorus1",
            "number": 6,
            "elements": [
              {
                "id": 0,
                "type": "text",
                "rect": [
                  610,
                  251,
                  775,
                  284
                ],
                "content": "Niist\u00e4 armosi, Jeesus,\nheijastuu niin kuin tuikkivat t\u00e4hdet,\nhohtaa kuu.",
                "font_size": 48,
                "color": [
                  255,
                  255,
                  255
                ],
                "align": "center"
              }
            ]
          },
          {
            "name": "Slide 7",
            "tag": "Chorus1",
            "number": 7,
            "elements": [
              {
                "id": 0,
                "type": "text",
                "rect": [
                  610,
                  251,
                  775,
                  284
                ],
                "content": "Niin kuin alusta ollut on, nyt on ja aina",
                "font_size": 48,
                "color": [
                  255,
                  255,
                  255
                ],
                "align": "center"
              }
            ]
          },
          {
            "name": "Slide 10",
            "tag": "Bridge",
            "number": 8,
            "elements": [
              {
                "id": 0,
                "type": "text",
                "rect": [
                  610,
                  251,
                  775,
                  284
                ],
                "content": "Halleluja, halleluja, Sin\u00e4 yksin olet pyh\u00e4.\nHalleluja, halleluja, Sin\u00e4 yksin olet korkein.",
                "font_size": 48,
                "color": [
                  255,
                  255,
                  255
                ],
                "align": "center"
              }
            ]
          },
          {
            "name": "Slide 8",
            "tag": "Verse3",
            "number": 9,
            "elements": [
              {
                "id": 0,
                "type": "text",
                "rect": [
                  610,
                  251,
                  775,
                  284
                ],
                "content": "Niin kuin alusta asti ollut on,\nyh\u00e4 armosi peitt\u00e4\u00e4 tuomion.",
                "font_size": 48,
                "color": [
                  255,
                  255,
                  255
                ],
                "align": "center"
              }
            ]
          },
          {
            "name": "Slide 9",
            "tag": "Verse3",
            "number": 10,
            "elements": [
              {
                "id": 0,
                "type": "text",
                "rect": [
                  610,
                  251,
                  775,
                  284
                ],
                "content": "Vaikka aika on ohikiit\u00e4v\u00e4\u00e4, Sinun sanasi,\nJeesus, aina j\u00e4\u00e4.",
                "font_size": 48,
                "color": [
                  255,
                  255,
                  255
                ],
                "align": "center"
              }
            ]
          }
        ],
        "type": "lyrics"
      },
